# ============================================================
# Argus 环境变量示例
#
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
#
# Argus 的三件套：DeepSeek（大模型）+ DashScope（向量模型）+ Tavily（搜索）。
# DeepSeek 没有 embeddings 接口，所以向量化必须走阿里 DashScope。
# ============================================================


# ---------- 大模型：DeepSeek（走 OpenAI 兼容接口） ----------

# 到 https://platform.deepseek.com 申请。
# 网页端会强制每位访客填写自己的 DeepSeek 密钥，这里的值只用于
# 命令行 / 代码直接调用（cli.py、自己写脚本跑 Argus 类）。
OPENAI_API_KEY=sk-填你的DeepSeek密钥
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 三个角色：快的做分类摘要，强的写报告，战略级做规划。
# 全部用 deepseek-chat 即可；想给规划换推理模型可改成 deepseek-reasoner。
FAST_LLM=openai:deepseek-chat
SMART_LLM=openai:deepseek-chat
STRATEGIC_LLM=openai:deepseek-chat


# ---------- 向量模型：阿里 DashScope ----------

# 到 https://bailian.console.aliyun.com 申请。
# 注意：访客的每次研究都会消耗【这里这个密钥】的 embedding 额度，
# 网页端无法让访客自带 DashScope 密钥。
DASHSCOPE_API_KEY=sk-填你的DashScope密钥

# 默认值就是 dashscope:text-embedding-v3，一般不需要改。
# 平台相关的坑（兼容端点、批量上限 10 条等）已在代码里处理好。
EMBEDDING=dashscope:text-embedding-v3


# ---------- 搜索引擎：Tavily ----------

# 到 https://app.tavily.com 申请，免费额度 1000 次/月。
# 网页端访客可选择自带 Tavily 密钥（用自己的额度）；
# 不带的访客会消耗这里的密钥，并受下方限流约束。
TAVILY_API_KEY=tvly-填你的Tavily密钥
RETRIEVER=tavily


# ---------- 可选 ----------

# 本地文档研究：把 PDF / Word / TXT 放进这个目录，
# 研究时可在网页上选择「本地文档」作为来源。
DOC_PATH=./my-docs

# 报告语言。默认已是简体中文，无需设置。
# 只写 "chinese" 分不清简繁，取材自港台来源的报告会输出繁体字。
# LANGUAGE=Simplified Chinese (简体中文)

# 报告目标长度（词数），默认 1200。
# TOTAL_WORDS=1200

# 每个访客 IP 每小时的限额：研究次数 / 对话次数。
# 访客自带 Tavily 密钥时不占研究限额。
# RATE_LIMIT_PER_HOUR=3
# RATE_LIMIT_CHAT_PER_HOUR=20

# 服务器上生成的研究报告保留天数，到期自动删除，保护访客隐私。
# 设为 0 表示永久保留（不推荐公开部署时这样做）。
# OUTPUTS_RETENTION_DAYS=7

# 允许跨域访问本服务的前端来源，多个用逗号分隔。
# CORS_ALLOW_ORIGINS=http://localhost:8000

# LangSmith 全链路追踪（排查问题时才需要）。
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__填你的LangSmith密钥
# LANGCHAIN_PROJECT=argus
